@page "/books"
@rendermode InteractiveServer
@using Contracts
@using Web.Services
@inject BooksApiClient Api
@implements IDisposable

<h3>Каталог бібліотеки</h3>

<div class="row g-2 mb-3 align-items-center">
    <div class="col-auto">
        <a class="btn btn-primary" href="/books/new">Додати видання</a>
    </div>
    <div class="col-md-4">
        <input class="form-control"
               placeholder="Пошук за автором..."
               @bind="searchAuthor"
               @bind:event="oninput"
               @bind:after="LoadBooksAsync" />
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="sortBy" @bind:after="LoadBooksAsync">
            <option value="">Сортування за замовчуванням</option>
            <option value="title">За назвою</option>
            <option value="author">За автором</option>
            <option value="copies">За кількістю примірників</option>
        </select>
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (items is null)
{
    <p><em>Завантаження каталогу...</em></p>
}
else if (items.Count == 0)
{
    <p>Видань у бібліотеці ще немає.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ISBN</th>
                <th>Назва</th>
                <th>Автор</th>
                <th>Рік</th>
                <th>Примірників</th>
                <th>Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>@item.Isbn</td>
                    <td>@item.Title</td>
                    <td>@item.Author</td>
                    <td>@item.Year</td>
                    <td>@item.Copies</td>
                    <td>
                        <a class="btn btn-sm btn-outline-secondary" href="@($"/books/{item.Id}")">Редагувати</a>
@if (confirmDeleteId == item.Id)
{
    <button class="btn btn-sm btn-danger ms-1" @onclick="() => ConfirmDeleteAsync(item.Id)">Підтвердити</button>
    <button class="btn btn-sm btn-secondary ms-1" @onclick="() => confirmDeleteId = null">Скасувати</button>
}
else
{
    <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => confirmDeleteId = item.Id">Видалити</button>
}
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<BookModel>? items;
    private string? error;
    private string? searchAuthor;
    private string? sortBy;
    private string? confirmDeleteId;
    private CancellationTokenSource? cts;

    protected override async Task OnInitializedAsync()
    {
        await LoadBooksAsync();
    }

    private async Task LoadBooksAsync()
    {
        cts?.Cancel();
        cts?.Dispose();
        cts = new CancellationTokenSource();
        var token = cts.Token;

        try
        {
            error = null;
            items = await Api.ListAsync(searchAuthor, sortBy, token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (HttpRequestException)
        {
            error = "Api недоступний. Перевірте, чи запущено сервер.";
        }
    }

    private async Task ConfirmDeleteAsync(string id)
    {
        var result = await Api.DeleteAsync(id);
        confirmDeleteId = null;

        if (result.Ok)
        {
            items?.RemoveAll(b => b.Id == id);
        }
        else
        {
            error = result.Message;
        }
    }

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
    }
}